# BrandSentinel AI — Environment Configuration
# Copy this to .env and fill in your values

# ─── Tier 1: Gemini Cloud API ───
GEMINI_API_KEY=
GEMINI_BACKUP_KEYS=
GEMINI_MODEL=gemini-2.5-flash

# ─── Tier 2: NVIDIA Cloud LLM (NIM) or Local LLM (Ollama / LM Studio) ───
LOCAL_LLM_ENABLED=true
LOCAL_LLM_ENDPOINT=https://integrate.api.nvidia.com/v1
LOCAL_LLM_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
CUSTOM_LLM_API_KEY=your_nvidia_or_custom_api_key_here

